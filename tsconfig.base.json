{
  "compileOnSave": false,
  "compilerOptions": {
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@org/invoices": ["apps/libs/invoices/src/index.ts"],
      "@org/shared": ["apps/libs/shared/src/index.ts"],
      "@org/styles": ["apps/libs/styles/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
